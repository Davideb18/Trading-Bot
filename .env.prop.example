# ==============================================================
# HyroTrader One-Step Prop Bot — Docker Environment Template
# ==============================================================
# Copy to .env on the AWS host and lock permissions:
#   cp .env.prop.example .env && chmod 600 .env
# NEVER commit .env or put real credentials in Git.
#
# Secret rules enforced by freqtrade/prop_security.py:
# - PROP_BYBIT_API_KEY must be >= 16 chars (standard Bybit keys are 18 chars)
# - PROP_BYBIT_API_SECRET, FREQTRADE_PASSWORD, FREQTRADE_JWT_TOKEN,
#   FREQTRADE_WS_TOKEN must each be >= 24 chars,
# - All 5 must contain >= 8 unique characters, have no whitespace, be distinct,
#   and avoid words like test/secret/example/password/changeme.
#
# Demo -> Live switch:
# 1) Create a fresh PROP_DATA_DIR (e.g. /home/ubuntu/freqtrade_prop_live)
# 2) Swap PROP_BYBIT_API_KEY, PROP_BYBIT_API_SECRET, and PROP_DATA_DIR below
# 3) Re-run scripts/prop_approve_config.py (--environment live) and
#    scripts/prop_secure_start.py commission before docker compose up -d --build
# ==============================================================

# Non-root host user/group owning PROP_DATA_DIR (run `id -u` and `id -g`)
PROP_UID=1000
PROP_GID=1000

# Dedicated private directory on host (chmod 700), NOT shared with other bots
# For 2-month Bybit Demo testing use a dedicated demo path first:
PROP_DATA_DIR=/home/ubuntu/freqtrade_prop_demo

# Dedicated Bybit Linear USDT Futures subaccount API credentials
# Swap these two values when migrating from Bybit Demo to HyroTrader Live
PROP_BYBIT_API_KEY=
PROP_BYBIT_API_SECRET=

# Internal Freqtrade API credentials shared between core and supervisor containers
# Generate random hex secrets with e.g. `openssl rand -hex 32`
FREQTRADE_USERNAME=propbot
FREQTRADE_PASSWORD=
FREQTRADE_JWT_TOKEN=
FREQTRADE_WS_TOKEN=

# Required safety acknowledgement checked by freqtrade/prop_security.py
PROP_EMERGENCY_AUTHORITY=dedicated-account-single-host

# Telegram alerts (drawdown warnings, consistency pause, halts, inactivity)
PROP_TELEGRAM_BOT_TOKEN=
PROP_TELEGRAM_CHAT_ID=

# Keep inactivity auto keep-alive trade disabled unless explicitly desired
PROP_INACTIVITY_KEEPALIVE=false

# Optional Gemini key (leave empty if unused)
GEMINI_API_KEY=

