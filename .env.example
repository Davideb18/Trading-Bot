# ==============================================================
# Zero-Burn — Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in the values before deploying.
#
#   cp .env.example .env
#   nano .env
#
# IMPORTANT: .env is in .gitignore and must NEVER be committed.
# ==============================================================

# --- Freqtrade API Credentials ---
# Must match username/password in user_data/config.json → api_server
FREQTRADE_PASSWORD=
FREQTRADE_JWT_TOKEN=

# --- Google Gemini API Key ---
# Used by the LLM Risk Manager for macro/micro sentiment analysis
GEMINI_API_KEY=
